# Release-builder image: compiles AND bundles on Ubuntu 22.04 (glibc 2.35,
# Qt 6.2), so the release binary matches the libraries it is bundled with.
# Used by .gitea/workflows/release.yml (local builds compile on rust-builder
# and only bundle with packaging/portable/Containerfile).
FROM docker.io/library/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV RUSTUP_HOME=/opt/rustup
ENV CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:/usr/local/go/bin:$PATH

# lld is required: .cargo/config.toml links with it (cxx-qt initializers).
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential clang libclang-dev lld cmake pkg-config git curl ca-certificates \
    file binutils patchelf libdbus-1-dev \
    libfontconfig1 libfreetype6 libdbus-1-3 libglib2.0-0 libgl1 \
    libx11-6 libxext6 libxrender1 libxcb1 \
    libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
    libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-shm0 \
    libxcb-sync1 libxcb-xfixes0 libxcb-xkb1 libxcb-xinerama0 \
    libxkbcommon-x11-0 libxkbcommon0 \
    libwayland-client0 libwayland-cursor0 libwayland-egl1 \
    qmake6 qt6-base-dev qt6-base-dev-tools qt6-declarative-dev qt6-wayland \
    libqt6svg6 libqt6svg6-dev \
    qml6-module-qtquick qml6-module-qtquick-controls \
    qml6-module-qtquick-layouts qml6-module-qtquick-templates \
    qml6-module-qtquick-window qml6-module-qtqml-workerscript \
    && rm -rf /var/lib/apt/lists/*

# librclone-sys builds rclone with `go build`; same Go as rust-builder.
RUN curl -fsSL https://go.dev/dl/go1.24.4.linux-amd64.tar.gz | tar -C /usr/local -xz

# Matches rust-toolchain.toml.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.85.0

WORKDIR /workspace
